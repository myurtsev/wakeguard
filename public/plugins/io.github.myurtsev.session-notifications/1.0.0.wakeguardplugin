{
  "apiVersion": 1,
  "id": "io.github.myurtsev.session-notifications",
  "name": "Session notifications",
  "version": "1.0.0",
  "author": "WakeGuard contributors",
  "description": "Shows a macOS notification when a WakeGuard session starts or stops.",
  "homepage": "https://github.com/myurtsev/wakeguard/tree/main/plugins/session-notifications",
  "permissions": {
    "notifications": true,
    "network": [],
    "openURLs": false
  },
  "settings": [
    {
      "key": "notifyOnStart",
      "label": "Notify when a session starts",
      "type": "toggle",
      "required": false,
      "defaultValue": "true"
    },
    {
      "key": "notifyOnStop",
      "label": "Notify when a session stops",
      "type": "toggle",
      "required": false,
      "defaultValue": "true"
    }
  ],
  "commands": [],
  "script": "function onEvent(event, api) {\n    var active = event.session.active;\n    api.setStatus(active ? \"Session active\" : \"Off\");\n\n    if (event.type !== \"stateChanged\" || !event.previousSession ||\n        event.previousSession.active === active) {\n        return;\n    }\n\n    if (active && api.settings.notifyOnStart === \"true\") {\n        api.notify(\"WakeGuard started\", \"Your keep-awake session is active.\");\n    } else if (!active && api.settings.notifyOnStop === \"true\") {\n        api.notify(\"WakeGuard stopped\", \"Your keep-awake session has ended.\");\n    }\n}\n"
}
